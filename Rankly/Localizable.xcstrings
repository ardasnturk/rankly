    "With the menu bar item on, Rankly keeps updating daily ranks in the background even after you close the main window.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist das Menüleistensymbol aktiv, aktualisiert Rankly die täglichen Ränge im Hintergrund weiter – auch nachdem du das Hauptfenster geschlossen hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el icono de la barra de menús activado, Rankly sigue actualizando las posiciones diarias en segundo plano aunque cierres la ventana principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque l’icône de la barre des menus est activée, Rankly continue de mettre à jour les classements quotidiens en arrière-plan, même après la fermeture de la fenêtre principale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l’icona nella barra dei menu attiva, Rankly continua ad aggiornare le posizioni giornaliere in background anche dopo la chiusura della finestra principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー項目をオンにしておくと、メインウインドウを閉じても Rankly はバックグラウンドで毎日の順位を更新し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 항목을 켜 두면 메인 윈도우를 닫아도 Rankly가 백그라운드에서 매일 순위를 계속 업데이트합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o ícone na barra de menus ativado, o Rankly continua atualizando as posições diárias em segundo plano mesmo depois que você fecha a janela principal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu açıkken ana pencereyi kapatsan da Rankly günlük sıralamaları arka planda günceller."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启菜单栏项目后，即使关闭主窗口，Rankly 也会继续在后台每日更新排名。"
          }
        }
      }
    },
