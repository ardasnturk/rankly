    "%lld countries · about %lld min (one by one in the background; slow so Apple doesn't block it)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Länder · ca. %lld Min. (nacheinander im Hintergrund; langsam, damit Apple nicht blockiert)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld países · unos %lld min (uno a uno en segundo plano; despacio para que Apple no lo bloquee)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pays · environ %lld min (un par un en arrière-plan ; lentement pour éviter un blocage par Apple)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld paesi · circa %lld min (uno alla volta in background; lentamente per evitare blocchi da parte di Apple)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld か国 · 約 %lld 分（バックグラウンドで1か国ずつ実行。Apple にブロックされないよう、ゆっくり処理します）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 국가 · 약 %lld분(백그라운드에서 하나씩 진행하며, Apple에 차단되지 않도록 천천히 진행됨)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld países · cerca de %lld min (um por vez em segundo plano; devagar para a Apple não bloquear)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
