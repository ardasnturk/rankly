    "Apple temporarily blocked App Store search for this network (403). Try again after %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat die App Store-Suche für dieses Netzwerk vorübergehend blockiert (403). Versuche es nach %@ erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ha bloqueado temporalmente la búsqueda del App Store para esta red (403). Vuelve a intentarlo después de las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a temporairement bloqué la recherche App Store pour ce réseau (403). Réessayez après %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ha bloccato temporaneamente la ricerca nell’App Store per questa rete (403). Riprova dopo le %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple がこのネットワークからの App Store 検索を一時的にブロックしました（403）。%@ 以降にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 이 네트워크의 App Store 검색을 일시적으로 차단했습니다(403). %@ 이후에 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple bloqueou temporariamente a busca da App Store para esta rede (403). Tente novamente depois das %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple, App Store aramasını bu ağ için geçici olarak engelledi (403). %@ sonrasında tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 暂时阻止了此网络的 App Store 搜索（403）。请在 %@ 之后重试。"
          }
        }
      }
    },
    "Apple temporarily blocked search. %lld countries done, %lld waiting. Continue after %@.": {
