    "Use “Multi-country Analysis…” to analyze every store that matches your app's languages in one go.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende „Mehrländer-Analyse …“, um alle Stores, die zu den Sprachen deiner App passen, in einem Durchgang zu analysieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa “Análisis multipaís…” para analizar de una vez todas las tiendas que coinciden con los idiomas de tu app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez « Analyse multipays… » pour analyser en une seule fois tous les stores correspondant aux langues de votre app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa “Analisi multi-paese…” per analizzare in un colpo solo tutti gli store che corrispondono alle lingue della tua app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「複数国の分析…」を使うと、App の言語に合うすべてのストアを一度に分析できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘다국가 분석…’을 사용하면 앱 언어와 일치하는 모든 스토어를 한 번에 분석할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Análise multipaís…” para analisar de uma só vez todas as lojas que correspondem aos idiomas do seu app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Çok ülkeli analiz…” ile uygulamanın dillerine uygun mağazaları tek seferde analiz et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“多国家分析…”可一次性分析与你的 App 语言匹配的所有商店。"
          }
        }
      }
    },
