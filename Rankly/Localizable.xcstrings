    "For the 100-character field in App Store Connect. Words already in the name and subtitle are not repeated.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das 100-Zeichen-Feld in App Store Connect. Wörter, die bereits in Name und Untertitel stehen, werden nicht wiederholt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el campo de 100 caracteres de App Store Connect. No se repiten las palabras que ya están en el nombre y el subtítulo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le champ de 100 caractères dans App Store Connect. Les mots déjà présents dans le nom et le sous-titre ne sont pas répétés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per il campo da 100 caratteri in App Store Connect. Le parole già presenti nel nome e nel sottotitolo non vengono ripetute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect の100文字の欄に使用できます。名前とサブタイトルに含まれる語は繰り返していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect의 100자 필드용입니다. 이름과 부제에 이미 있는 단어는 반복하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o campo de 100 caracteres do App Store Connect. Palavras que já estão no nome e no subtítulo não são repetidas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect'teki 100 karakterlik alan için. Ad ve alt başlıktaki kelimeler tekrar edilmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于 App Store Connect 中的 100 字符字段。名称和副标题中已有的词不会重复。"
          }
        }
      }
    },
