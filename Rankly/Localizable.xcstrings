    "Other: no localization in these languages; the app appears in its default language and ranks poorly": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere: keine Lokalisierung in diesen Sprachen; die App erscheint in ihrer Standardsprache und rankt schlecht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
