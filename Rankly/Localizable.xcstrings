    "These words use valuable space but you don't appear in the top 250 for them; consider replacing them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wörter belegen wertvollen Platz, aber du erscheinst für sie nicht in den Top 250. Erwäge, sie zu ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas palabras ocupan un espacio valioso, pero no apareces en el top 250 para ellas; plantéate sustituirlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces mots occupent un espace précieux, mais vous n’apparaissez pas dans le top 250 pour eux ; envisagez de les remplacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste parole occupano spazio prezioso, ma non compari nella top 250 per esse; valuta di sostituirle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの語は貴重なスペースを使っていますが、上位250位以内に表示されていません。置き換えを検討してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단어들은 귀중한 공간을 차지하지만 상위 250위 안에 나타나지 않습니다. 교체를 고려해 보십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas palavras ocupam um espaço valioso, mas você não aparece no top 250 para elas; considere substituí-las."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kelimeler değerli alanı kullanıyor ama ilk 250'de çıkmıyorsun; değiştirmeyi düşünebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些词占用了宝贵的空间，但你并未出现在其前 250 名中；建议考虑替换。"
          }
        }
      }
    },
